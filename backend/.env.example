# Environment Configuration for India Sales Analytics Dashboard Backend

# Paths
DATA_PATH=backend/data/raw
PROCESSED_DATA_PATH=backend/data/processed
MODELS_DIR=backend/models

# CORS (Comma-separated origins for Lovable React frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database URL (SQLite)
DATABASE_URL=sqlite:///backend/data/processed/sales_analytics.db

# Debug mode
DEBUG=False
